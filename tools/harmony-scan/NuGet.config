<?xml version="1.0" encoding="utf-8"?>
<!-- Everything this tool uses ships in the .NET shared framework, so restore has nothing to
     fetch. Clearing the sources keeps a build working on a machine with no network, and keeps
     a dependency from creeping in unnoticed: adding a PackageReference now fails the build. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
