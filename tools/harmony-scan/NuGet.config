<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org, named explicitly.

     The scanner itself has no package references: everything it uses ships in the .NET shared
     framework, so a plain build fetches nothing. Publishing is different — the AOT compiler and
     the runtime pack come from nuget.org — and this file makes sure the source is there even on
     a machine whose global NuGet configuration has cleared it.

     Do not clear the sources here. That makes a plain build work offline and makes every publish
     fail with a wall of NU1100 "unable to resolve" errors that read like a broken project rather
     than a missing source. NuGet.offline.config is for the offline case, asked for by name.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
