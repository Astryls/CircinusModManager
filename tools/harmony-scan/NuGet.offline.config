<?xml version="1.0" encoding="utf-8"?>
<!-- For building the scanner with no network: it clears the package sources, which works
     because a plain build needs no packages at all.

     It is NOT the default, and it must never be. Publishing with AOT fetches the AOT compiler
     and the runtime pack from nuget.org, and with the sources cleared that fails with a wall of
     NU1100 "unable to resolve" errors that read like a broken project rather than a missing
     source. Pass this file explicitly when you want the offline build:

         dotnet build -c Release [configfile] NuGet.offline.config
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
