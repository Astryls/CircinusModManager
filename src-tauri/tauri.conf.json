{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Circinus Mod Manager",
  "version": "1.6.0",
  "identifier": "sh.circinus.modmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Circinus Mod Manager",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0b0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mod manager for RimWorld with HALO load ordering",
    "longDescription": "Circinus Mod Manager organizes RimWorld mods into groups, validates them against community rules, and orders them with HALO, the Harmonized Automated Load Order.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREQ0FEMTU0NzkyRUFBMDUKUldRRnFpNTVWTkhLM2NiSGExdS8xaXBIOWI1UFNBeVZ1VCtoY01iUFZiTyt3cEVFR1R1RmRtRk4K",
      "endpoints": [
        "https://circinus.sh/api/v1/releases/latest.json",
        "https://circinus.sh/modmanager/update/{{target}}/{{arch}}/{{current_version}}?installer={{bundle_type}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
